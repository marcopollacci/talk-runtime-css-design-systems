---
/**
 * Meme.astro
 *
 * Classic meme template + captions written in HTML/CSS (not baked into the
 * image): editable, themeable, accessible. Captions are placed with % offsets
 * and sized in container query units, so the meme itself is responsive.
 */
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Caption {
  text: string;
  /** centre of the caption, in % of the image */
  x: number;
  y: number;
  /** max width, in % of the image (default 45) */
  w?: number;
  /** font size, in cqh (default 8) */
  size?: number;
  /** "impact" = white + black outline, "ink" = dark text for white panels */
  look?: "impact" | "ink";
  code?: boolean;
  /** text alignment inside the caption (default center; "start" keeps code indentation) */
  align?: "center" | "start";
  rotate?: number;
}

interface Props {
  src: ImageMetadata;
  alt: string;
  captions: Caption[];
  height?: string;
}

const { src, alt, captions, height = "11em" } = Astro.props;
---

<figure
  class="meme"
  style={`--meme-height: ${height}; --meme-ratio: ${src.width} / ${src.height};`}
>
  <Image src={src} alt={alt} />
  {
    captions.map(
      ({ text, x, y, w = 45, size = 8, look = "impact", code, align = "center", rotate = 0 }) => (
        <span
          class:list={["meme-caption", look, { code }]}
          style={`--x: ${x}%; --y: ${y}%; --w: ${w}%; --size: ${size}cqh; --rotate: ${rotate}deg; --align: ${align};`}
        >
          {text}
        </span>
      ),
    )
  }
</figure>

<style lang="scss">
  .meme {
    position: relative;
    height: var(--meme-height);
    aspect-ratio: var(--meme-ratio);
    margin: 0 auto;
    container-type: size;
    border-radius: 0.3em;
    overflow: hidden;
    box-shadow: 0 0.3em 1.2em rgb(0 0 0 / 0.45);

    :global(img) {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }

  .meme-caption {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: max-content;
    max-width: var(--w);
    translate: -50% -50%;
    rotate: var(--rotate);
    font-size: var(--size);
    line-height: 1.05;
    text-align: var(--align);
    text-wrap: balance;

    &.impact {
      font-family: Impact, "Anton", "Arial Black", sans-serif;
      text-transform: uppercase;
      color: white;
      -webkit-text-stroke: 0.06em black;
      paint-order: stroke fill;
      letter-spacing: 0.02em;
    }

    &.ink {
      font-family: var(--talk-marco-graphik-medium, sans-serif);
      color: oklch(0.2 0 0);
    }

    &.code {
      font-family: var(--font-mono, ui-monospace, monospace);
      text-transform: none;
      /* break only where the caption says so (\n), never inside a token */
      white-space: pre;
    }
  }
</style>
