---
import { Image } from "astro:assets";
import bfe25logo from "../img/logo-bfe.svg";
---

<p-slide class="cover">
  <h1>Less build, more runtime: The modern CSS approach to Design Systems</h1>
  <Image
    src={bfe25logo}
    alt="bologna frontend logo"
    class="alter-image-size"
    style="--image-start-size: 2em; margin-block-start: 5rem;"
  />
  <p-note class="center bottom-fist-page text-sub-section">
    <span>Marco Pollacci</span>
    <span>13/10/2026 - Granada, Bologna</span>
  </p-note>
</p-slide>
