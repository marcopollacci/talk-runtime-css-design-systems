---
import bfe from "../img/cropped-bfe-favicon-32x32.webp";
import me2 from "../img/me2.png";
import qrRating from "../img/qrrating_bfe2026.png";
import qrslide from "../img/qrslide_bfe2026.png";
import Layout from "../layouts/Layout.astro";
import CardBridge from "../slides/card-bridge.astro";
import Cascade from "../slides/cascade.astro";
import Colors from "../slides/colors.astro";
import Context from "../slides/context.astro";
import ContrastColor from "../slides/contrast-color.astro";
import CoverBfe2026 from "../slides/cover-bfe-2026.astro";
import Cover from "../slides/cover.astro";
import Example from "../slides/example-bfe.astro";
import Intro from "../slides/intro.astro";
import Nesting from "../slides/nesting.astro";
import Next from "../slides/next-bfe.astro";
import Outro from "../slides/outro.astro";
import Space from "../slides/space.astro";
import StyleQueries from "../slides/style-queries.astro";
import Thanks from "../slides/thanks.astro";
import ThreadIntro from "../slides/thread-intro.astro";
import WebMcp from "../slides/webmcp.astro";
const favIcon = bfe.src;
const canRender = import.meta.env.DEV || new Date("2026-10-13") < new Date();
const metaData = {
  title: "Less Build, More Runtime: The Modern CSS Approach to Design Systems",
  description:
    "Slides for building runtime-ready design systems with modern CSS.",
  image: "og-image.png",
  site: "https://talk-runtime-css-design-systems.marcotalk.dev/bfe-2026/",
};
---

<Layout {canRender} {favIcon} {metaData}>
  <CoverBfe2026 />
  {canRender && (
    <>
      <Cover meReloaded={me2} />
      <Intro />
      <ThreadIntro />
      <Cascade />
      <CardBridge section="cascade" />
      <Nesting />
      <Colors />
      <ContrastColor />
      <CardBridge section="colors" />
      <Space />
      <CardBridge section="space" />
      <Context />
      <StyleQueries />
      <CardBridge section="context" />
      <Next />
      <Example />
      <Outro />
      <WebMcp />
      <Thanks
        qrLinkRating={qrRating}
        qrLink={qrslide}
        urlLink={metaData.site}
        meReloaded={me2}
      />
    </>
  )}
</Layout>
